<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dcx.Notify (0.3.0 §3 / §4, docs/PLAN-0.3.0.md): what leaves the app to tell someone — syslog over TLS only (RFC 5424
       over RFC 5425) and e-mail notifications over TLS only. No third-party packages: SslStream, sockets and the store's
       own encryption. Its screens (Settings cards, the Privacy & network box) are in the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DcxManager</RootNamespace>
    <AssemblyName>Dcx.Notify</AssemblyName>
    <Product>DarkCipher ServerManagement</Product>
    <Company>DarkCipher Systems</Company>
    <Copyright>Copyright © 2026 DarkCipher Systems</Copyright>
    <DebugType>none</DebugType>
    <!-- Keep local build paths (user name) out of compiled code -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dcx.Core\Dcx.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcxServerManager" />
  </ItemGroup>

</Project>
