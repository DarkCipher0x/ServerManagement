<Window x:Class="DcxManager.Views.HostEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Host" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="{DynamicResource FsBase}" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" SourceInitialized="OnSourceInitialized">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Root" Margin="20,16">
        <TextBlock x:Name="Heading" Text="Host" Style="{StaticResource H1}" Margin="0,0,0,4"/>
        <TextBlock x:Name="SubHeading" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="TYPE" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="ProtoSsh" Content="SSH (Linux / Unix)" GroupName="proto" Margin="0,0,14,0" IsChecked="True" Checked="OnProtoChanged"/>
            <RadioButton x:Name="ProtoRdp" Content="Remote Desktop (Windows)" GroupName="proto" Margin="0,0,14,0" Checked="OnProtoChanged"/>
            <RadioButton x:Name="ProtoVnc" Content="VNC (Mac / Linux desktop)" GroupName="proto" Margin="0,0,14,0" Checked="OnProtoChanged"
                         ToolTip="A Mac's Screen Sharing or a Linux VNC server (TigerVNC, x11vnc, GNOME / KDE remote desktop with VNC), in a tab. Through an SSH tunnel by default."/>
            <RadioButton x:Name="ProtoTelnet" Content="Telnet (legacy, unencrypted)" GroupName="proto" Checked="OnProtoChanged" Visibility="Collapsed"
                         ToolTip="Shown because Telnet is allowed in Settings → Terminal &amp; connections. Everything is sent unencrypted."/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NAME" Style="{StaticResource Label}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>
                <TextBlock Text="ADDRESS (host name or IP)" Style="{StaticResource Label}"/>
                <TextBox x:Name="AddressBox" Style="{StaticResource Field}" FontFamily="{DynamicResource MonoFont}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="USERNAME" Style="{StaticResource Label}"/>
                        <TextBox x:Name="UserBox" Style="{StaticResource Field}" FontFamily="{DynamicResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PORT" Style="{StaticResource Label}"/>
                        <TextBox x:Name="PortBox" Style="{StaticResource Field}" FontFamily="{DynamicResource MonoFont}" Text="22"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="SavedOnly">
                    <TextBlock Text="GROUP" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="GroupBox" IsEditable="True" Margin="0,0,0,10"/>
                    <TextBlock Text="TAGS" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TagsBox" Style="{StaticResource Field}" ToolTip="Comma separated, e.g. prod, web, ubuntu"/>
                    <TextBlock Text="PLATFORM (for the Hosts tree)" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PlatformBox" Margin="0,0,0,10" ToolTip="Auto = Windows for Remote Desktop hosts, Linux otherwise. Network device for switches, routers, UniFi, PDUs…"/>
                    <TextBlock Text="ENVIRONMENT" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="EnvBox" Margin="0,0,0,10" ToolTip="Shown on the host, its tabs and its sessions. PRODUCTION asks you to type the host's name before reboots, deletes, service changes and multi-host runs."/>
                    <TextBlock x:Name="TermProfileLabel" Text="TERMINAL PROFILE" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="TermProfileBox" Margin="0,0,0,10" ToolTip="Colours, cursor, encoding, key mappings and logging for this host's terminals (Settings → Terminal profiles)."/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="SignInLabel" Text="SIGN IN WITH" Style="{StaticResource Label}"/>
                <StackPanel x:Name="AuthChoice" Orientation="Horizontal" Margin="0,2,0,10">
                    <RadioButton x:Name="AuthKey" Content="SSH key" GroupName="auth" Margin="0,0,14,0" Checked="OnAuthChanged"/>
                    <RadioButton x:Name="AuthPassword" Content="Password" GroupName="auth" Margin="0,0,14,0" Checked="OnAuthChanged"/>
                    <RadioButton x:Name="AuthInteractive" Content="Interactive / 2FA" GroupName="auth" Checked="OnAuthChanged"
                                 ToolTip="keyboard-interactive: answers server prompts such as OTP codes; a saved password answers the password prompt"/>
                </StackPanel>
                <CheckBox x:Name="SshKerberos" Content="Single sign-on with my Windows account (Kerberos)" Margin="0,0,0,10"
                          ToolTip="Opens this host with Windows' OpenSSH client and your Kerberos ticket (GSSAPI): no password or key, for domain-joined Linux servers (sssd / realmd). Settings → Identity &amp; directory."/>
                <TextBlock x:Name="CredLabel" Text="CREDENTIAL FROM VAULT" Style="{StaticResource Label}"/>
                <DockPanel x:Name="CredRow" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="＋ New" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnNewCredential"/>
                    <Button x:Name="FindCredButton" DockPanel.Dock="Right" Content="🔍 Find…" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnFindCredential"
                            ToolTip="Search this vault, Bitwarden, Secrets Manager and Password Safe"/>
                    <ComboBox x:Name="CredBox" DisplayMemberPath="Display" SelectionChanged="OnCredChanged"/>
                </DockPanel>
                <!-- Inline secret: used for ad-hoc connections, or saved into the vault for a new host -->
                <StackPanel x:Name="InlinePanel">
                    <StackPanel x:Name="InlinePassword">
                        <TextBlock Text="PASSWORD" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel x:Name="InlineKey">
                        <TextBlock Text="PRIVATE KEY FILE" Style="{StaticResource Label}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnBrowseKey"/>
                            <TextBox x:Name="KeyPathBox" Padding="5,4" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsSmall}"/>
                        </DockPanel>
                        <TextBlock Text="KEY PASSPHRASE (if any)" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="PassphraseBox" Margin="0,0,0,10"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SshOnly">
                    <TextBlock Text="SUDO PASSWORD (optional)" Style="{StaticResource Label}"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="🔍 Find…" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnFindSudo"
                                ToolTip="Search this vault, Bitwarden, Secrets Manager and Password Safe"/>
                        <ComboBox x:Name="SudoBox" DisplayMemberPath="Display"
                                  ToolTip="Password credential used for sudo when the host signs in with a key. Sent over stdin, never on the command line."/>
                    </DockPanel>
                    <TextBlock Text="CONNECT THROUGH (jump host)" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="JumpBox" DisplayMemberPath="Display" Margin="0,0,0,10"/>
                    <TextBlock Text="VPN (brought up before connecting)" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="VpnBox" DisplayMemberPath="Display" Margin="0,0,0,10"
                              ToolTip="A WireGuard / OpenVPN profile from Tunnels → VPN: the app brings it up before this host's connections open"/>
                    <TextBlock Text="KEEPALIVE (seconds, 0 = off)" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="KeepAliveBox" IsEditable="True" Width="110" HorizontalAlignment="Left" Margin="0,0,0,10"
                              ToolTip="SSH keepalive interval. Keeps NAT / firewall state alive through idle periods and detects dead links on long sessions. 15–60 s is typical."/>
                </StackPanel>
                <StackPanel x:Name="RdpOnly" Visibility="Collapsed">
                    <TextBlock Text="DOMAIN (optional)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="RdpDomain" Style="{StaticResource Field}"/>
                    <TextBlock Text="SIGN IN" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="RdpSignOn" Margin="0,0,0,10"
                              ToolTip="Single sign-on uses the account you signed in to Windows with: no password is typed or stored. Remote Credential Guard and Restricted Admin keep your credentials off the server. Settings → Identity &amp; directory explains what the server and Group Policy need."/>
                    <TextBlock Text="RD GATEWAY (optional)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="RdpGateway" Style="{StaticResource Field}" FontFamily="{DynamicResource MonoFont}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Border x:Name="RdpOptions" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="REMOTE DESKTOP" Style="{StaticResource Label}"/>
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="RdpFull" Content="Full screen" Margin="0,0,14,6"/>
                    <TextBlock Text="or window" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                    <TextBox x:Name="RdpW" Width="56" Padding="4,2" Margin="0,0,4,6"/>
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,4,6"/>
                    <TextBox x:Name="RdpH" Width="56" Padding="4,2" Margin="0,0,14,6"/>
                    <CheckBox x:Name="RdpMulti" Content="All monitors" Margin="0,0,14,6"/>
                    <CheckBox x:Name="RdpAdmin" Content="Admin session (/admin)" Margin="0,0,14,6"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="RdpClip" Content="Clipboard" Margin="0,0,14,6"/>
                    <CheckBox x:Name="RdpDrives" Content="Local drives" Margin="0,0,14,6"/>
                    <CheckBox x:Name="RdpPrinters" Content="Printers" Margin="0,0,14,6"/>
                    <CheckBox x:Name="RdpMic" Content="Microphone" Margin="0,0,14,6"/>
                    <TextBlock Text="audio" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                    <ComboBox x:Name="RdpAudio" Width="130" Margin="0,0,0,6"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="RdpReconnect" Content="Auto-reconnect when the link drops, up to" Margin="0,0,6,6"/>
                    <TextBox x:Name="RdpRetries" Width="44" Padding="4,2" Margin="0,0,6,6"/>
                    <TextBlock Text="attempts · server-side keepalive: right-click the host → RDP server keepalive commands" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border x:Name="VncOptions" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="VNC" Style="{StaticResource Label}"/>
                <WrapPanel Margin="0,4,0,6">
                    <RadioButton x:Name="VncMac" Content="Mac (Screen Sharing: macOS user name and password)" GroupName="vnckind" Margin="0,0,14,4"/>
                    <RadioButton x:Name="VncPlain" Content="VNC server (VNC password, or none)" GroupName="vnckind" Margin="0,0,14,4" IsChecked="True"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <RadioButton x:Name="VncThroughSsh" Content="Through SSH (encrypted)" GroupName="vncroute" Margin="0,0,10,4" IsChecked="True" Checked="OnVncRouteChanged"
                                 ToolTip="The session goes through an SSH tunnel to the machine: encrypted whatever the VNC server offers. Needs the machine's SSH (on a Mac: System Settings → General → Sharing → Remote Login)."/>
                    <RadioButton x:Name="VncDirect" Content="Direct to the VNC port" GroupName="vncroute" Margin="0,0,10,4" Checked="OnVncRouteChanged"
                                 ToolTip="Straight to port 5900. Only VeNCrypt (TLS) encrypts the picture and keys; a Mac or a plain VNC password protects the sign-in only."/>
                </WrapPanel>
                <StackPanel x:Name="VncSshPanel">
                    <TextBlock Text="SSH HOST FOR THE TUNNEL" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="VncSshBox" DisplayMemberPath="Display" Margin="0,0,0,8"
                              ToolTip="A saved SSH host: usually the same machine's SSH entry. (Automatic) picks a saved SSH host with the same address."/>
                    <TextBlock Text="VNC SERVER SEEN FROM THAT SSH HOST" Style="{StaticResource Label}"/>
                    <TextBox x:Name="VncTarget" Style="{StaticResource Field}" FontFamily="{DynamicResource MonoFont}" Width="220" HorizontalAlignment="Left"
                             ToolTip="127.0.0.1 when the VNC server runs on the SSH host itself; another address to reach a machine behind it"/>
                </StackPanel>
                <TextBlock x:Name="VncDirectWarning" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,0,0,6"
                           Text="⚠ Direct: unless the server offers VeNCrypt with a certificate (pinned on first use), the screen and your keystrokes cross the network unencrypted."/>
                <WrapPanel>
                    <CheckBox x:Name="VncScale" Content="Scale to the tab" Margin="0,0,14,6" IsChecked="True"/>
                    <CheckBox x:Name="VncViewOnly" Content="View only" Margin="0,0,14,6"/>
                    <CheckBox x:Name="VncShared" Content="Share with other viewers" Margin="0,0,14,6" IsChecked="True"/>
                    <CheckBox x:Name="VncClipboard" Content="Take the remote clipboard" Margin="0,0,14,6"
                              ToolTip="Copy text the remote side copies onto this PC's clipboard. Off by default: the server could fill your clipboard. Sending your clipboard is always a button in the tab."/>
                </WrapPanel>
                <DockPanel x:Name="VncPinRow" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Content="Forget" Style="{StaticResource SmallButton}" Click="OnVncForgetPin"/>
                    <TextBlock x:Name="VncPin" Style="{StaticResource Hint}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <StackPanel x:Name="NotesPanel">
            <TextBlock Text="NOTES" Style="{StaticResource Label}"/>
            <TextBox x:Name="NotesBox" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5,4"/>
        </StackPanel>
        <StackPanel x:Name="AdHocPanel" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="OPEN AS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="OpenTerminal" Content="Terminal" GroupName="open" IsChecked="True" Margin="0,0,12,0"/>
            <RadioButton x:Name="OpenFiles" Content="Files (SFTP)" GroupName="open" Margin="0,0,12,0"/>
            <RadioButton x:Name="OpenManage" Content="Manage" GroupName="open" Margin="0,0,12,0"/>
            <RadioButton x:Name="OpenExternal" Content="Windows Terminal" GroupName="open" Margin="0,0,18,0"/>
            <CheckBox x:Name="SaveHost" Content="Save as a host"/>
        </StackPanel>
        <TextBlock x:Name="TestResult" Style="{StaticResource Hint}" Margin="0,10,0,0" FontFamily="{DynamicResource MonoFont}"/>
        <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" x:Name="TestButton" Content="Test connection" Click="OnTest"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="100"/>
                <Button Content="Cancel" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
